DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
JWT_SIGNING_KEY=replace-with-a-different-long-random-development-key
DATABASE_URL=postgresql://salesmind:replace-with-local-db-password@127.0.0.1:5432/salesmind
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Embedding provider
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_BATCH_SIZE=32

# Language-model provider
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# One solution-generation call can ask for thousands of output tokens; a lower
# value times out mid-answer on a real corpus.
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_THINKING_ENABLED=false

# Solution V2 uses this hard output ceiling for each generation pass.
SOLUTION_DRAFT_MAX_OUTPUT_TOKENS=6000

# Independent proposal verifier (API key intentionally empty).
# The DeepSeek verifier explicitly sends thinking.type=disabled;
# there is no separate VERIFIER_THINKING_ENABLED environment setting.
VERIFIER_PROVIDER=deepseek
VERIFIER_MODEL=deepseek-flash
VERIFIER_API_KEY=
VERIFIER_BASE_URL=https://api.deepseek.com
VERIFIER_TIMEOUT_SECONDS=60
VERIFIER_MAX_RETRIES=0
VERIFIER_MAX_OUTPUT_TOKENS=1500
VERIFIER_MAX_CONCURRENCY=2

# Required for durable review workflows and seed_demo/clear_demo.
# Set only to an explicitly authorized local/checkpoint database URL.
# Checkpoint tables require explicit setup; imports do not create them.
LANGGRAPH_CHECKPOINT_DATABASE_URL=

# Knowledge indexing limits
KNOWLEDGE_MAX_FILE_SIZE_BYTES=20971520
KNOWLEDGE_MAX_PDF_PAGES=300
KNOWLEDGE_MAX_CHUNKS=500
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_INDEXING_STALE_TIMEOUT_SECONDS=3600

# Rate limits (DRF scopes). Production requires every value to be explicit.
THROTTLE_ANON_RATE=30/min
THROTTLE_USER_RATE=600/hour
THROTTLE_LOGIN_RATE=10/min
THROTTLE_TOKEN_REFRESH_RATE=120/hour
THROTTLE_SOLUTION_GENERATION_RATE=20/hour
THROTTLE_REQUIREMENT_ANALYSIS_RATE=40/hour
THROTTLE_RAG_ANSWER_RATE=60/hour
THROTTLE_KNOWLEDGE_WRITE_RATE=20/hour

# Number of trusted reverse proxies in front of the app. Must equal the real
# hop count: too small merges every client into one bucket, too large trusts the
# client-supplied X-Forwarded-For segment. Local direct connections have no XFF,
# so 1 is harmless here.
DRF_NUM_PROXIES=1

# Asynchronous generation queue. A running job refreshes its heartbeat every
# SOLUTION_GENERATION_JOB_HEARTBEAT_SECONDS; a job silent for longer than
# SOLUTION_GENERATION_JOB_STALE_SECONDS is treated as abandoned, and after
# SOLUTION_GENERATION_JOB_MAX_ATTEMPTS it fails as workflow_worker_lost.
SOLUTION_GENERATION_ASYNC=false
SOLUTION_GENERATION_JOB_STALE_SECONDS=600
SOLUTION_GENERATION_JOB_HEARTBEAT_SECONDS=60
SOLUTION_GENERATION_JOB_MAX_ATTEMPTS=2

# Reviewer notices. Both channels are opt-in: without a reachable SMTP host or a
# chat webhook a submission must not wait on the network. The public base URL
# only builds the link, and the mail channel needs a working EMAIL_* transport.
NOTIFICATION_EMAIL_ENABLED=false
REVIEW_WEBHOOK_URL=
SALESMIND_PUBLIC_BASE_URL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=salesmind@example.internal

# Queue alarms, configured separately from reviewer notices: breaches usually go
# to whoever runs the service, review pings to whoever reviews solutions. With
# both empty the health check still exits non-zero, it just cannot push anywhere.
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=

# Shared by both webhook channels.
WEBHOOK_TIMEOUT_SECONDS=5

# A quote discount above this percentage needs an administrator's written
# approval before the quote page may be exported. Below it, no decision is
# required and the quote exports normally.
QUOTE_DISCOUNT_APPROVAL_THRESHOLD_PERCENT=15

# PostgreSQL test database template prepared during phase-three Task 0
TEST_DATABASE_TEMPLATE=salesmind_test_template
