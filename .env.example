DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
JWT_SIGNING_KEY=replace-with-a-different-long-random-development-key
DATABASE_URL=postgresql://salesmind:replace-with-local-db-password@127.0.0.1:5432/salesmind
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Embedding provider
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_BATCH_SIZE=32

# Language-model provider
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_THINKING_ENABLED=false

# Solution V2 uses this hard output ceiling for each generation pass.
SOLUTION_DRAFT_MAX_OUTPUT_TOKENS=6000

# Independent proposal verifier (API key intentionally empty).
# The Qwen verifier factory explicitly sends enable_thinking=false;
# there is no separate VERIFIER_THINKING_ENABLED environment setting.
VERIFIER_PROVIDER=openai_compatible
VERIFIER_MODEL=qwen3.8-flash
VERIFIER_API_KEY=
VERIFIER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VERIFIER_TIMEOUT_SECONDS=60
VERIFIER_MAX_RETRIES=0
VERIFIER_MAX_OUTPUT_TOKENS=1500
VERIFIER_MAX_CONCURRENCY=2

# Required for durable review workflows and seed_demo/clear_demo.
# Set only to an explicitly authorized local/checkpoint database URL.
# Checkpoint tables require explicit setup; imports do not create them.
LANGGRAPH_CHECKPOINT_DATABASE_URL=

# Knowledge indexing limits
KNOWLEDGE_MAX_FILE_SIZE_BYTES=20971520
KNOWLEDGE_MAX_PDF_PAGES=300
KNOWLEDGE_MAX_CHUNKS=500
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_INDEXING_STALE_TIMEOUT_SECONDS=3600

# PostgreSQL test database template prepared during phase-three Task 0
TEST_DATABASE_TEMPLATE=salesmind_test_template
