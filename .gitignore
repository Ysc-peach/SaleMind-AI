# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/

# Environment and secrets
.env
.env.*
!.env.example

# Django
staticfiles/
media/

# Local database and media backups
backups/

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Coverage artefacts (produced by COVERAGE=1 bash scripts/verify.sh backend)
.coverage
.coverage.*
coverage.xml
htmlcov/

# Evaluation corpus: third-party text stays local, only the manifest is shared.
# The directory itself is not excluded, otherwise git never looks inside and the
# negation below cannot match.
knowledge-seed/*/*
!knowledge-seed/*/sources.json

# Superpowers execution workspace
.superpowers/
.worktrees/

